---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";

const pageTitle = `${profile.name} | ${profile.title}`;
const pageDescription = profile.pitch;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <a class="skip-link" href="#main-content">Skip to content</a>

  <header class="hero container" aria-labelledby="hero-title">
    <p class="eyebrow">{profile.location}</p>
    <h1 id="hero-title">{profile.name}</h1>
    <p class="hero__role">{profile.title}</p>
    <p class="hero__pitch">{profile.pitch}</p>
    <p class="hero__intro">{profile.intro}</p>

    <nav class="link-row" aria-label="Primary links">
      <a href={profile.cvPath} download>CV (PDF)</a>
      <a href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={profile.links.scholar} target="_blank" rel="noreferrer">Google Scholar</a>
      <a href={`mailto:${profile.email}`}>Email</a>
    </nav>
  </header>

  <main id="main-content" class="container content">
    <section class="section" aria-labelledby="metrics-title">
      <h2 id="metrics-title">Selected Impact</h2>
      <ul class="metrics-list">
        {profile.metrics.map((metric) => (
          <li>
            <strong>{metric.value}</strong> {metric.label}: {metric.context}
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="experience-title">
      <h2 id="experience-title">Experience</h2>
      {profile.experienceHighlights.map((experience) => (
        <article class="entry">
          <header class="entry__header">
            <h3>{experience.role}</h3>
            <p class="meta">{experience.company} · {experience.period} · {experience.location}</p>
          </header>
          <p>{experience.summary}</p>
          <ul>
            {experience.bullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="stack">Stack: {experience.stack.join(", ")}</p>
        </article>
      ))}
    </section>

    <section class="section" aria-labelledby="projects-title">
      <h2 id="projects-title">Projects</h2>
      {profile.projects.map((project) => (
        <article class="entry">
          <header class="entry__header">
            <h3>{project.name}</h3>
            <p class="meta">{project.role} · {project.period}</p>
          </header>
          <p>{project.summary}</p>
          <ul>
            {project.bullets.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="stack">Stack: {project.stack.join(", ")}</p>
        </article>
      ))}
    </section>

    <section class="section" aria-labelledby="publications-title">
      <h2 id="publications-title">Publications</h2>
      <ol class="publication-list">
        {profile.publications.map((publication) => (
          <li>
            <p class="publication-title">{publication.title}</p>
            <p class="meta">
              {publication.authors} · {publication.venue} ({publication.year}) · {publication.citations} citations
            </p>
          </li>
        ))}
      </ol>
      <p>
        Full list: <a href={profile.links.scholar} target="_blank" rel="noreferrer">Google Scholar profile</a>
      </p>
    </section>

    <section class="section" aria-labelledby="skills-title">
      <h2 id="skills-title">Skills</h2>
      <div class="skills-list">
        {profile.skills.map((group) => (
          <p>
            <strong>{group.category}:</strong> {group.items.join(", ")}
          </p>
        ))}
      </div>
    </section>
  </main>

  <footer class="footer container">
    <p>{profile.name}</p>
    <p>
      <a href={`mailto:${profile.email}`}>{profile.email}</a> · <a href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a> · <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub</a> · <a href={profile.links.medium} target="_blank" rel="noreferrer">Medium</a>
    </p>
  </footer>
</BaseLayout>
